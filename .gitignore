# ========================================
# RECIPE FINDER - COMPLETE .gitignore
# ========================================

# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/
.pnp/
.pnp.js

# Environment Variables (CRITICAL)
.env
backend/.env
frontend/.env
.env.local
.env.production
.env.development

# Database Files
*.db
*.db-journal
*.sqlite
*.sqlite3
backend/*.db
backend/*.db-journal

# Build Outputs
dist/
build/
frontend/build/
frontend/dist/
backend/dist/
out/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
.tmp/
.cache/

# IDE
.vscode/
.idea/
.history/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Testing
coverage/
.nyc_output/
*.lcov

# Lock Files (Optional - uncomment if you want to commit)
# package-lock.json
# backend/package-lock.json
# frontend/package-lock.json

# API Keys & Secrets (CRITICAL - NEVER COMMIT)
*.pem
*.key
*.crt
*.p12
api-keys.txt
secrets.json

# OS Files
.DS_Store
.AppleDouble
Thumbs.db
Desktop.ini
.directory

# Temporary Files
*.tmp
*.temp
*.bak
*.cache